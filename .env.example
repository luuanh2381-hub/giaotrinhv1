# === 1. Neon PostgreSQL (AWS Asia Pacific 1 - Singapore) ===
# Copy Pooled connection string from Neon Console (include ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# === 2. Admin Authentication ===
# Random secret >= 32 chars used to sign HttpOnly JWT session cookies
ADMIN_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Used ONLY once to auto-create the first admin account if admin_users table is empty.
# After first login, change your password in Admin Dashboard (or remove ADMIN_DEFAULT_PASSWORD).
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=change-me-now-strong-password

# Comma-separated IPs or CIDRs that can NEVER be blocked (emergency self-lockout protection)
ADMIN_WHITELIST_IPS=

# === 3. Vercel Global Config (formerly Edge Config — Site-wide IP Blocking ~1ms) ===
# Automatically injected by Vercel when you connect a Global Config store to your project:
GLOBAL_CONFIG=https://edge-config.vercel.com/ecfg_xxxxxxxx?token=xxxxxxxx
# (Legacy EDGE_CONFIG is also supported automatically)

# Personal / Team Vercel API Token (Account Settings -> Tokens) to sync blocked_ips from Neon to Global Config
VERCEL_API_TOKEN=vercel_api_token_here

# Optional: only required if the Global Config belongs to a Vercel Team (starts with team_...)
VERCEL_TEAM_ID=
# Optional: auto-extracted from GLOBAL_CONFIG URL if omitted
GLOBAL_CONFIG_ID=
